# Optional public professional email, shown in the footer and enquiry pages.
CONTACT_EMAIL=
# PostgreSQL connection string used to store enquiries.
DATABASE_URL=
# Optional HTTPS notification endpoint called after an enquiry is saved.
ENQUIRY_WEBHOOK_URL=
# Optional server-only bearer token for the delivery service.
ENQUIRY_WEBHOOK_TOKEN=
# Password for /admin/all/responses. Use a long, unique value and keep it server-only.
ADMIN_PASSWORD=
